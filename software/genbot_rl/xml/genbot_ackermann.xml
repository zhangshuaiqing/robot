<mujoco model="genbot_ackermann">
  <!--
    GenBot 阿克曼四轮底盘
    前轮：sphere（转向），通过 hinge joint 绕 Z 轴转动
    后轮：sphere（驱动），通过 motor 直接驱动
    使用 sphere 确保接触计算稳定可靠
  -->
  <compiler angle="radian" coordinate="local" meshdir="none"/>

  <option timestep="0.005" integrator="Euler">
    <flag gravity="enable" contact="enable"/>
  </option>

  <size nstack="300000" nconmax="400"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".15 .15 .15" rgb2=".2 .2 .2" width="512" height="512"/>
    <material name="ground" texture="grid" texrepeat="4 4"/>
    <material name="chassis" rgba="0.25 0.25 0.28 1.0"/>
    <material name="wheel" rgba="0.08 0.08 0.08 1.0"/>
    <material name="target" rgba="0.0 0.8 0.0 0.6"/>
    <material name="obstacle" rgba="0.8 0.2 0.2 0.8"/>
  </asset>

  <default>
    <geom friction="1.5 0.1 0.01" condim="3" solref="0.02 1.0" solimp="0.9 0.95 0.001"/>
    <joint damping="0.05" frictionloss="0.01"/>
  </default>

  <worldbody>
    <light name="light0" pos="0 0 3" dir="0 0 -1" directional="true" castshadow="true"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="ground"/>

    <!-- ==================== 底盘 ==================== -->
    <body name="chassis" pos="0 0 0.09">
      <!-- 6自由度：x, y, z + 四元数 -->
      <freejoint/>

      <!-- 底盘几何体 -->
      <geom name="chassis_geom" type="box" size="0.200 0.140 0.040" material="chassis" mass="4.0"/>
      <inertial pos="0 0 0" mass="4.0" diaginertia="0.02 0.03 0.04"/>

      <!-- ===== 前左轮 ===== -->
      <body name="fl_wheel" pos="0.150 0.120 -0.040">
        <!-- 转向关节：绕 Z 轴旋转 -->
        <joint name="fl_steer" type="hinge" axis="0 0 1" limited="true" range="-0.6 0.6"/>
        <!-- 球体做轮子，半径为0.048m -->
        <geom name="fl_wheel_geom" type="sphere" size="0.048" mass="0.3" material="wheel"/>
      </body>

      <!-- ===== 前右轮 ===== -->
      <body name="fr_wheel" pos="0.150 -0.120 -0.040">
        <joint name="fr_steer" type="hinge" axis="0 0 1" limited="true" range="-0.6 0.6"/>
        <geom name="fr_wheel_geom" type="sphere" size="0.048" mass="0.3" material="wheel"/>
      </body>

      <!-- ===== 后左轮 ===== -->
      <body name="rl_wheel" pos="-0.150 0.120 -0.040">
        <joint name="rl_joint" type="hinge" axis="0 1 0"/>
        <geom name="rl_wheel_geom" type="sphere" size="0.048" mass="0.5" material="wheel"/>
      </body>

      <!-- ===== 后右轮 ===== -->
      <body name="rr_wheel" pos="-0.150 -0.120 -0.040">
        <joint name="rr_joint" type="hinge" axis="0 1 0"/>
        <geom name="rr_wheel_geom" type="sphere" size="0.048" mass="0.5" material="wheel"/>
      </body>

      <!-- LiDAR 位置 -->
      <site name="lidar_site" pos="0 0 0.050" size="0.01 0.01 0.01"/>
    </body>

    <!-- ==================== 目标点 ==================== -->
    <body name="target" pos="2.0 0 0.01">
      <geom name="target_geom" type="sphere" size="0.15" material="target"/>
    </body>

    <!-- ==================== 障碍物（可添加） ==================== -->
    <body name="wall1" pos="1.0 0.5 0.25">
      <geom name="wall1_geom" type="box" size="0.05 0.3 0.25" material="obstacle"/>
    </body>
    <body name="wall2" pos="1.0 -0.5 0.25">
      <geom name="wall2_geom" type="box" size="0.05 0.3 0.25" material="obstacle"/>
    </body>
  </worldbody>

  <!-- ==================== 执行器 ==================== -->
  <actuator>
    <!-- 后轮驱动 -->
    <motor name="left_motor" joint="rl_joint" ctrlrange="-5.0 5.0" ctrllimited="true"/>
    <motor name="right_motor" joint="rr_joint" ctrlrange="-5.0 5.0" ctrllimited="true"/>
    <!-- 前轮转向 -->
    <position name="fl_steer_act" joint="fl_steer" kp="5.0" ctrlrange="-0.6 0.6" ctrllimited="true"/>
    <position name="fr_steer_act" joint="fr_steer" kp="5.0" ctrlrange="-0.6 0.6" ctrllimited="true"/>
  </actuator>
</mujoco>
