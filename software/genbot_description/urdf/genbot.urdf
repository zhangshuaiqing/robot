      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <geometry>
        <box size="0.4 0.28 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <inertia ixx="0.02826666666666667" ixy="0" ixz="0" iyy="0.05546666666666667" iyz="0" izz="0.07946666666666669"/>
    </inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.09"/>
  </joint>
  <!-- ================================================================ -->
  <!--  前轮 — 左（转向节 + 转向关节 + 轮子 + 滚动关节）                -->
  <!-- ================================================================ -->
  <link name="front_left_steering_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.030 0.030 0.080"/>
      </geometry>
      <material name="UprightSilver"/>
    </visual>
    <collision>
