      <geometry>
        <box size="0.030 0.030 0.080"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="9.125e-05" ixy="0" ixz="0" iyy="9.125e-05" iyz="0" izz="2.2499999999999998e-05"/>
    </inertial>
  </link>
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steering_link"/>
    <origin rpy="0 0 0" xyz="0.15 0.12 -0.04"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-0.6" upper="0.6" velocity="3.0"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>
  <link name="front_left_wheel">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.05"/>
      </geometry>
      <material name="WheelBlack"/>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.00021812500000000003" ixy="0" ixz="0" iyy="0.00021812500000000003" iyz="0" izz="0.000375"/>
    </inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steering_link"/>
    <child link="front_left_wheel"/>
    <origin rpy="0 0 0" xyz="0 0 -0.045"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.5" velocity="10.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>
  <!-- ================================================================ -->
  <!--  前轮 — 右                                                      -->
  <!-- ================================================================ -->
  <link name="front_right_steering_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.030 0.030 0.080"/>
      </geometry>
      <material name="UprightSilver"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.030 0.030 0.080"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="9.125e-05" ixy="0" ixz="0" iyy="9.125e-05" iyz="0" izz="2.2499999999999998e-05"/>
    </inertial>
  </link>
  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steering_link"/>
    <origin rpy="0 0 0" xyz="0.15 -0.12 -0.04"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-0.6" upper="0.6" velocity="3.0"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>
  <link name="front_right_wheel">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.05"/>
      </geometry>
      <material name="WheelBlack"/>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.00021812500000000003" ixy="0" ixz="0" iyy="0.00021812500000000003" iyz="0" izz="0.000375"/>
    </inertial>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steering_link"/>
    <child link="front_right_wheel"/>
    <origin rpy="0 0 0" xyz="0 0 -0.045"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.5" velocity="10.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>
  <!-- ================================================================ -->
  <!--  后轮 — 左（仅驱动，不转向）                                    -->
  <!-- ================================================================ -->
  <link name="rear_left_wheel">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.05"/>
      </geometry>
      <material name="WheelBlack"/>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.00021812500000000003" ixy="0" ixz="0" iyy="0.00021812500000000003" iyz="0" izz="0.000375"/>
    </inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin rpy="0 0 0" xyz="-0.15 0.12 -0.04"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.5" velocity="10.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>
  <!-- ================================================================ -->
  <!--  后轮 — 右                                                      -->
  <!-- ================================================================ -->
  <link name="rear_right_wheel">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.05"/>
      </geometry>
      <material name="WheelBlack"/>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.00021812500000000003" ixy="0" ixz="0" iyy="0.00021812500000000003" iyz="0" izz="0.000375"/>
    </inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin rpy="0 0 0" xyz="-0.15 -0.12 -0.04"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.5" velocity="10.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>
  <!-- ========== RPLIDAR A1 ========== -->
  <link name="lidar_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <geometry>
        <cylinder length="0.050" radius="0.049"/>
      </geometry>
      <material name="LidarBlue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <geometry>
        <cylinder length="0.050" radius="0.049"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.12"/>
      <inertia ixx="9.703e-05" ixy="0" ixz="0" iyy="9.703e-05" iyz="0" izz="0.00014406"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.07"/>
  </joint>
  <!-- ========== Realsense D435 ========== -->
  <link name="camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0.045 0 0"/>
      <geometry>
        <box size="0.090 0.025 0.025"/>
      </geometry>
      <material name="CameraDark"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.045 0.008 0.008"/>
      <geometry>
        <box size="0.005 0.015 0.012"/>
      </geometry>
      <material name="LensRed"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.045 0 0"/>
      <geometry>
        <box size="0.090 0.025 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="1.5625e-05" ixy="0" ixz="0" iyy="0.00010906249999999999" iyz="0" izz="0.00010906249999999999"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0 0" xyz="0.19 0 0.055"/>
  </joint>
  <!-- ========== MPU6050 IMU ========== -->
  <link name="imu_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.020 0.015 0.005"/>
      </geometry>
      <material name="LensRed"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.020 0.015 0.005"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1.0416666666666667e-07" ixy="0" ixz="0" iyy="1.7708333333333334e-07" iyz="0" izz="2.604166666666667e-07"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!--
   ============================================================
    GenBot Ackermann — Gazebo Harmonic (gz-sim 8) 插件配置
   ============================================================
   后轮: DiffDrive（速度控制）
   前轮: JointPositionController（位置控制，阿克曼转角）
   ============================================================
  -->
  <!-- 底盘物理 -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
    <gravity>true</gravity>
    <selfCollide>false</selfCollide>
    <kinematic>false</kinematic>
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <friction1>0.5</friction1>
    <friction2>0.5</friction2>
  </gazebo>
  <!-- 后轮驱动 — 高摩擦 -->
  <gazebo reference="rear_left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <friction1>1.0</friction1>
    <friction2>1.0</friction2>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <friction1>1.0</friction1>
    <friction2>1.0</friction2>
    <material>Gazebo/Black</material>
  </gazebo>
  <!-- 前轮转向节 — 中等摩擦 -->
  <gazebo reference="front_left_steering_link">
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>
  <gazebo reference="front_right_steering_link">
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>
  <!-- 前轮 — 低摩擦（转向轮需要低侧向摩擦） -->
  <gazebo reference="front_left_wheel">
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
    <material>Gazebo/Black</material>
  </gazebo>
  <!-- ============================================================ -->
  <!--  后轮差速驱动（DiffDrive）                                    -->
  <!--  订阅 /cmd_vel 中的 linear.x 速度                            -->
  <!-- ============================================================ -->
  <gazebo>
    <plugin filename="libgz-sim-diff-drive-system.so" name="gz::sim::systems::DiffDrive">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.24</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <odom_publisher_frequency>50</odom_publisher_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <min_velocity>-0.5</min_velocity>
      <max_velocity>0.5</max_velocity>
      <min_acceleration>-0.3</min_acceleration>
      <max_acceleration>0.3</max_acceleration>
    </plugin>
  </gazebo>
  <!-- ============================================================ -->
  <!--  前轮转向控制（JointPositionController）                     -->
  <!--  通过 /cmd_steer_left 和 /cmd_steer_right 控制转向角度       -->
  <!--  阿克曼转角由外部节点计算后发布                               -->
  <!-- ============================================================ -->
  <gazebo>
    <plugin filename="libgz-sim-joint-position-controller-system.so" name="gz::sim::systems::JointPositionController">
      <joint_name>front_left_steering_joint</joint_name>
      <topic>/cmd_steer_left</topic>
      <use_cmd_composition>false</use_cmd_composition>
      <publish_cmd>true</publish_cmd>
      <publish_state>true</publish_state>
      <publish_pose>true</publish_pose>
      <publish_wrench>false</publish_wrench>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="libgz-sim-joint-position-controller-system.so" name="gz::sim::systems::JointPositionController">
      <joint_name>front_right_steering_joint</joint_name>
      <topic>/cmd_steer_right</topic>
      <use_cmd_composition>false</use_cmd_composition>
      <publish_cmd>true</publish_cmd>
      <publish_state>true</publish_state>
      <publish_pose>true</publish_pose>
      <publish_wrench>false</publish_wrench>
    </plugin>
  </gazebo>
  <!-- ============================================================ -->
  <!--  LiDAR                                                       -->
  <!-- ============================================================ -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.283185</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.015</resolution>
        </range>
      </lidar>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
  <!-- ============================================================ -->
  <!--  RGB 相机 + 深度相机                                         -->
  <!-- ============================================================ -->
  <gazebo reference="camera_link">
    <sensor name="rgb_camera" type="camera">
      <topic>/camera/color/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.204</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>30.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
    <sensor name="depth_camera" type="depth_camera">
      <topic>/camera/depth/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.396</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>L16</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>
  <!-- ============================================================ -->
  <!--  IMU                                                        -->
  <!-- ============================================================ -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu/data_raw</topic>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>
</robot>
