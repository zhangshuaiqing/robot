<?xml version="1.0"?>
<robot name="genbot_gazebo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
   ============================================================
    GenBot Ackermann — Gazebo Harmonic (gz-sim 8) 插件配置
   ============================================================
   后轮: DiffDrive（速度控制）
   前轮: JointPositionController（位置控制，阿克曼转角）
   ============================================================
  -->

  <!-- 底盘物理 -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
    <gravity>true</gravity>
    <selfCollide>false</selfCollide>
    <kinematic>false</kinematic>
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <friction1>0.5</friction1>
    <friction2>0.5</friction2>
  </gazebo>

  <!-- 后轮驱动 — 高摩擦 -->
  <gazebo reference="rear_left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <friction1>1.0</friction1>
    <friction2>1.0</friction2>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <friction1>1.0</friction1>
    <friction2>1.0</friction2>
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- 前轮转向节 — 中等摩擦 -->
  <gazebo reference="front_left_steering_link">
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>
  <gazebo reference="front_right_steering_link">
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>

  <!-- 前轮 — 低摩擦（转向轮需要低侧向摩擦） -->
  <gazebo reference="front_left_wheel">
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- ============================================================ -->
  <!--  后轮差速驱动（DiffDrive）                                    -->
  <!--  订阅 /cmd_vel 中的 linear.x 速度                            -->
  <!-- ============================================================ -->
  <gazebo>
    <plugin filename="libgz-sim-diff-drive-system.so"
            name="gz::sim::systems::DiffDrive">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${wheel_track}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publisher_frequency>50</odom_publisher_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <min_velocity>-0.5</min_velocity>
      <max_velocity>0.5</max_velocity>
      <min_acceleration>-0.3</min_acceleration>
      <max_acceleration>0.3</max_acceleration>
    </plugin>
  </gazebo>

  <!-- ============================================================ -->
  <!--  前轮转向控制（JointPositionController）                     -->
  <!--  通过 /cmd_steer_left 和 /cmd_steer_right 控制转向角度       -->
  <!--  阿克曼转角由外部节点计算后发布                               -->
  <!-- ============================================================ -->
  <gazebo>
    <plugin filename="libgz-sim-joint-position-controller-system.so"
            name="gz::sim::systems::JointPositionController">
      <joint_name>front_left_steering_joint</joint_name>
      <topic>/cmd_steer_left</topic>
      <use_cmd_composition>false</use_cmd_composition>
      <publish_cmd>true</publish_cmd>
      <publish_state>true</publish_state>
      <publish_pose>true</publish_pose>
      <publish_wrench>false</publish_wrench>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="libgz-sim-joint-position-controller-system.so"
            name="gz::sim::systems::JointPositionController">
      <joint_name>front_right_steering_joint</joint_name>
      <topic>/cmd_steer_right</topic>
      <use_cmd_composition>false</use_cmd_composition>
      <publish_cmd>true</publish_cmd>
      <publish_state>true</publish_state>
      <publish_pose>true</publish_pose>
      <publish_wrench>false</publish_wrench>
    </plugin>
  </gazebo>

  <!-- ============================================================ -->
  <!--  LiDAR                                                       -->
  <!-- ============================================================ -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.283185</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.015</resolution>
        </range>
      </lidar>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!--  RGB 相机 + 深度相机                                         -->
  <!-- ============================================================ -->
  <gazebo reference="camera_link">
    <sensor name="rgb_camera" type="camera">
      <topic>/camera/color/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.204</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>30.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>

    <sensor name="depth_camera" type="depth_camera">
      <topic>/camera/depth/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.396</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>L16</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!--  IMU                                                        -->
  <!-- ============================================================ -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu/data_raw</topic>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

</robot>
