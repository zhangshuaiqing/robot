<?xml version="1.0"?>
<robot name="genbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
   ============================================================
    GenBot 4WD — 4轮差速通用机器人开发平台
   ============================================================
   底盘: 350mm x 280mm
   驱动: 后轮JGA25-371直流有刷编码电机
   从动: 前工业万向轮
   传感器: RPLIDAR A1 (顶) + Realsense D435 (前) + MPU6050 (内)
   仿真: Gazebo Harmonic (gz-sim 8)
   ============================================================
  -->

  <!-- 颜色定义 -->
  <material name="ChassisGray">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>
  <material name="WheelBlack">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="CasterSilver">
    <color rgba="0.70 0.70 0.72 1.0"/>
  </material>
  <material name="LidarBlue">
    <color rgba="0.10 0.30 0.80 1.0"/>
  </material>
  <material name="CameraDark">
    <color rgba="0.15 0.15 0.18 1.0"/>
  </material>
  <material name="LensRed">
    <color rgba="0.70 0.10 0.10 1.0"/>
  </material>

  <!-- ========== 机器人参数 ========== -->
  <xacro:property name="chassis_length"  value="0.350"/>
  <xacro:property name="chassis_width"   value="0.280"/>
  <xacro:property name="chassis_height"  value="0.080"/>
  <xacro:property name="clearance"       value="0.050"/>

  <xacro:property name="wheel_radius"    value="0.050"/>
  <xacro:property name="wheel_width"     value="0.035"/>
  <xacro:property name="wheel_track"     value="0.240"/>
  <xacro:property name="wheel_base"      value="0.220"/>

  <xacro:property name="caster_radius"   value="0.020"/>
  <xacro:property name="caster_arm"      value="0.025"/>

  <!-- ========== 惯性宏 ========== -->
  <xacro:macro name="inertia_box" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${(1/12)*mass*(y*y+z*z)}"
               iyy="${(1/12)*mass*(x*x+z*z)}"
               izz="${(1/12)*mass*(x*x+y*y)}"
               ixy="0" iyz="0" ixz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertia_cyl" params="mass r l">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${(1/12)*mass*(3*r*r+l*l)}"
               iyy="${(1/12)*mass*(3*r*r+l*l)}"
               izz="${0.5*mass*r*r}"
               ixy="0" iyz="0" ixz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertia_sphere" params="mass r">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${0.4*mass*r*r}"
               iyy="${0.4*mass*r*r}"
               izz="${0.4*mass*r*r}"
               ixy="0" iyz="0" ixz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ========== base_footprint（地面投影）========== -->
  <link name="base_footprint"/>

  <!-- ========== 底盘 ========== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="ChassisGray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:inertia_box mass="4.0" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${clearance + chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ========== 后轮 — 驱动轮（左）========== -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="WheelBlack"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
    <xacro:inertia_cyl mass="0.3" r="${wheel_radius}" l="${wheel_width}"/>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="${-wheel_base/2} ${wheel_track/2} ${-chassis_height/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.5" velocity="10.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- ========== 后轮 — 驱动轮（右）========== -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="WheelBlack"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
    <xacro:inertia_cyl mass="0.3" r="${wheel_radius}" l="${wheel_width}"/>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="${-wheel_base/2} ${-wheel_track/2} ${-chassis_height/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.5" velocity="10.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- ========== 前万向轮 — 左 ========== -->
  <link name="caster_front_left_fork">
    <visual>
      <origin xyz="0 0 ${-caster_arm/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="${caster_arm}"/></geometry>
      <material name="CasterSilver"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${-caster_arm/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="${caster_arm}"/></geometry>
    </collision>
    <xacro:inertia_cyl mass="0.03" r="0.008" l="${caster_arm}"/>
  </link>

  <joint name="caster_front_left_fork_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_front_left_fork"/>
    <origin xyz="${chassis_length/2 - 0.030} ${0.100} ${-chassis_height/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.001" friction="0.001"/>
  </joint>

  <link name="caster_front_left_wheel">
    <visual>
      <origin xyz="0 0 ${-caster_arm}" rpy="0 0 0"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="WheelBlack"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${-caster_arm}" rpy="0 0 0"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:inertia_sphere mass="0.05" r="${caster_radius}"/>
  </link>

  <joint name="caster_front_left_wheel_joint" type="continuous">
    <parent link="caster_front_left_fork"/>
    <child link="caster_front_left_wheel"/>
    <origin xyz="0 0 ${-caster_arm}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.001" friction="0.001"/>
  </joint>

  <!-- ========== 前万向轮 — 右 ========== -->
  <link name="caster_front_right_fork">
    <visual>
      <origin xyz="0 0 ${-caster_arm/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="${caster_arm}"/></geometry>
      <material name="CasterSilver"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${-caster_arm/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="${caster_arm}"/></geometry>
    </collision>
    <xacro:inertia_cyl mass="0.03" r="0.008" l="${caster_arm}"/>
  </link>

  <joint name="caster_front_right_fork_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_front_right_fork"/>
    <origin xyz="${chassis_length/2 - 0.030} ${-0.100} ${-chassis_height/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.001" friction="0.001"/>
  </joint>

  <link name="caster_front_right_wheel">
    <visual>
      <origin xyz="0 0 ${-caster_arm}" rpy="0 0 0"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="WheelBlack"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${-caster_arm}" rpy="0 0 0"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:inertia_sphere mass="0.05" r="${caster_radius}"/>
  </link>

  <joint name="caster_front_right_wheel_joint" type="continuous">
    <parent link="caster_front_right_fork"/>
    <child link="caster_front_right_wheel"/>
    <origin xyz="0 0 ${-caster_arm}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.001" friction="0.001"/>
  </joint>

  <!-- ========== RPLIDAR A1 ========== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.049" length="0.050"/></geometry>
      <material name="LidarBlue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.049" length="0.050"/></geometry>
    </collision>
    <xacro:inertia_cyl mass="0.12" r="0.049" l="0.050"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${chassis_height/2 + 0.030}" rpy="0 0 0"/>
  </joint>

  <!-- ========== Realsense D435 ========== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0.045 0 0" rpy="0 0 0"/>
      <geometry><box size="0.090 0.025 0.025"/></geometry>
      <material name="CameraDark"/>
    </visual>
    <!-- 镜头 -->
    <visual>
      <origin xyz="0.045 0.008 0.008" rpy="0 0 0"/>
      <geometry><box size="0.005 0.015 0.012"/></geometry>
      <material name="LensRed"/>
    </visual>
    <collision>
      <origin xyz="0.045 0 0" rpy="0 0 0"/>
      <geometry><box size="0.090 0.025 0.025"/></geometry>
    </collision>
    <xacro:inertia_box mass="0.15" x="0.090" y="0.025" z="0.025"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_length/2 - 0.010} 0 ${chassis_height/2 + 0.015}" rpy="0 0 0"/>
  </joint>

  <!-- ========== MPU6050 IMU ========== -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.020 0.015 0.005"/></geometry>
      <material name="LensRed"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.020 0.015 0.005"/></geometry>
    </collision>
    <xacro:inertia_box mass="0.005" x="0.020" y="0.015" z="0.005"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo 插件配置 -->
  <xacro:include filename="$(find genbot_description)/urdf/genbot.gazebo.xacro" />

</robot>
