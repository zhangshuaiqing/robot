<?xml version="1.0"?>
<robot name="genbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
   ============================================================
    GenBot Ackermann — 阿克曼转向通用机器人开发平台
   ============================================================
   底盘: 400mm x 280mm
   转向: 前轮阿克曼转向（左右转角不同）
   驱动: 后轮JGA25-371直流有刷编码电机
   传感器: RPLIDAR A1 (顶) + Realsense D435 (前) + MPU6050 (内)
   仿真: Gazebo Harmonic (gz-sim 8)
   ============================================================
  -->

  <material name="ChassisGray">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>
  <material name="WheelBlack">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="UprightSilver">
    <color rgba="0.70 0.70 0.72 1.0"/>
  </material>
  <material name="LidarBlue">
    <color rgba="0.10 0.30 0.80 1.0"/>
  </material>
  <material name="CameraDark">
    <color rgba="0.15 0.15 0.18 1.0"/>
  </material>
  <material name="LensRed">
    <color rgba="0.70 0.10 0.10 1.0"/>
  </material>

  <!-- ========== 机器人参数 ========== -->
  <xacro:property name="wheel_base"    value="0.300"/>
  <xacro:property name="wheel_track"   value="0.240"/>
  <xacro:property name="chassis_length" value="0.400"/>
  <xacro:property name="chassis_width"  value="0.280"/>
  <xacro:property name="chassis_height" value="0.080"/>
  <xacro:property name="clearance"      value="0.050"/>

  <xacro:property name="wheel_radius"   value="0.050"/>
  <xacro:property name="wheel_width"    value="0.035"/>

  <!-- ========== 惯性宏 ========== -->
  <xacro:macro name="inertia_box" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${(1/12)*mass*(y*y+z*z)}"
               iyy="${(1/12)*mass*(x*x+z*z)}"
               izz="${(1/12)*mass*(x*x+y*y)}"
               ixy="0" iyz="0" ixz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertia_cyl" params="mass r l">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${(1/12)*mass*(3*r*r+l*l)}"
               iyy="${(1/12)*mass*(3*r*r+l*l)}"
               izz="${0.5*mass*r*r}"
               ixy="0" iyz="0" ixz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ========== base_footprint ========== -->
  <link name="base_footprint"/>

  <!-- ========== 底盘 ========== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="ChassisGray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:inertia_box mass="4.0" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${clearance + chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================ -->
  <!--  前轮 — 左（转向节 + 转向关节 + 轮子 + 滚动关节）                -->
  <!-- ================================================================ -->

  <link name="front_left_steering_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.080"/></geometry>
      <material name="UprightSilver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.080"/></geometry>
    </collision>
    <xacro:inertia_box mass="0.15" x="0.03" y="0.03" z="0.08"/>
  </link>

  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steering_link"/>
    <origin xyz="${wheel_base/2} ${wheel_track/2} ${-chassis_height/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" velocity="3.0" lower="-0.6" upper="0.6"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="WheelBlack"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
    <xacro:inertia_cyl mass="0.3" r="${wheel_radius}" l="${wheel_width}"/>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steering_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 -0.045" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.5" velocity="10.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- ================================================================ -->
  <!--  前轮 — 右                                                      -->
  <!-- ================================================================ -->

  <link name="front_right_steering_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.080"/></geometry>
      <material name="UprightSilver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.080"/></geometry>
    </collision>
    <xacro:inertia_box mass="0.15" x="0.03" y="0.03" z="0.08"/>
  </link>

  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steering_link"/>
    <origin xyz="${wheel_base/2} ${-wheel_track/2} ${-chassis_height/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" velocity="3.0" lower="-0.6" upper="0.6"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="WheelBlack"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
    <xacro:inertia_cyl mass="0.3" r="${wheel_radius}" l="${wheel_width}"/>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steering_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 -0.045" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.5" velocity="10.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- ================================================================ -->
  <!--  后轮 — 左（仅驱动，不转向）                                    -->
  <!-- ================================================================ -->

  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="WheelBlack"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
    <xacro:inertia_cyl mass="0.3" r="${wheel_radius}" l="${wheel_width}"/>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="${-wheel_base/2} ${wheel_track/2} ${-chassis_height/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.5" velocity="10.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- ================================================================ -->
  <!--  后轮 — 右                                                      -->
  <!-- ================================================================ -->

  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="WheelBlack"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
    <xacro:inertia_cyl mass="0.3" r="${wheel_radius}" l="${wheel_width}"/>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="${-wheel_base/2} ${-wheel_track/2} ${-chassis_height/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.5" velocity="10.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- ========== RPLIDAR A1 ========== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.049" length="0.050"/></geometry>
      <material name="LidarBlue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.049" length="0.050"/></geometry>
    </collision>
    <xacro:inertia_cyl mass="0.12" r="0.049" l="0.050"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${chassis_height/2 + 0.030}" rpy="0 0 0"/>
  </joint>

  <!-- ========== Realsense D435 ========== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0.045 0 0" rpy="0 0 0"/>
      <geometry><box size="0.090 0.025 0.025"/></geometry>
      <material name="CameraDark"/>
    </visual>
    <visual>
      <origin xyz="0.045 0.008 0.008" rpy="0 0 0"/>
      <geometry><box size="0.005 0.015 0.012"/></geometry>
      <material name="LensRed"/>
    </visual>
    <collision>
      <origin xyz="0.045 0 0" rpy="0 0 0"/>
      <geometry><box size="0.090 0.025 0.025"/></geometry>
    </collision>
    <xacro:inertia_box mass="0.15" x="0.090" y="0.025" z="0.025"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_length/2 - 0.010} 0 ${chassis_height/2 + 0.015}" rpy="0 0 0"/>
  </joint>

  <!-- ========== MPU6050 IMU ========== -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.020 0.015 0.005"/></geometry>
      <material name="LensRed"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.020 0.015 0.005"/></geometry>
    </collision>
    <xacro:inertia_box mass="0.005" x="0.020" y="0.015" z="0.005"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="$(find genbot_description)/urdf/genbot.gazebo.xacro"/>

</robot>
