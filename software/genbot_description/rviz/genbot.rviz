Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Reference Frame: base_footprint
      Plane Cell Count: 20
      Plane Cell Size: 0.2
    - Alpha: 0.8
      Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Robot Description: robot_description
      Visual Enabled: true
      TF Prefix: ""
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic: /scan
      Size (m): 0.05
      Style: Points
      Color: 255 85 0
    - Class: rviz_default_plugins/Image
      Name: Camera
      Topic: /camera/image_raw
    - Class: rviz_default_plugins/Pose
      Name: Odometry
      Topic: /odom
      Color: 0 255 0
      Arrow Length: 0.3
      Arrow Radius: 0.05
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point: [0, 0, 0]
